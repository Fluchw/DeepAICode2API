# 构建产物
/deepaicode2api
/deepaicode2api.exe
/register
/register.exe
/bin/
/dist/
*.exe
*.out
*.test
coverage.out

# 临时文件
*.tmp
*.swp
*~

# 运行期状态（含上游 API Key / 密码，务必不要入库）
/deepaicode2api-data.json
/deepaicode2api-data.json.*
# 日志/统计旁路文件（P0 拆分后新增，同样是运行期产物）
/deepaicode2api-data-*.json
/deepaicode2api-data-*.jsonl
/data/
/gw.log
/*.log
/*.meta

# 注册台账 / 交付物（含 API Key 与密码）
/exports/
/result/
/test-*.json
/*.jsonl
/*.har
/test-*.jsonl
/test-*.log
/regtest.log

# 本地测试 / 逆向产物
/.console-check.js
/.recon/
/deepai.org.har
# 抓包目录：HAR 内含 API Key / Cookie，绝不入库
/accounts/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# 本地凭据 / 代理（绝不入库）
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
credentials*.json

# 部署时的本机 compose 覆盖（网络 / 端口 / 镜像 tag），不入库
/docker-compose.override.yml

# 机密 env(2026-11-25 从 /etc/ 搬到项目目录):admin 口令 / master key / machine id。
# ⚠️ 必须挡在这里 —— 上游 .gitignore 只写了 `.env` 和 `.env.*`,`deepaicode2api.env`
# 不在覆盖范围内,漏了就会被 git add . 提交到远端仓库。
deepaicode2api.env
*.env
!*.env.example
